@model IEnumerable<CRUD_Clientes.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="container pt-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Lista de Clientes</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Cliente" asp-action="Crear" class="btn btn-primary">Nuevo cliente</a>
        </div>
    </div>

    <br />

    @if (Model.Any())
    {
        <table class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Tipo de documento</th>
                    <th>Documento</th>
                    <th>Celular</th>
                    <th>Dirección</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.TipoDocumento</td>
                        <td>@item.Documento</td>
                        <td>@item.Celular</td>
                        <td>@item.Direccion</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-controller="Cliente" asp-action="Editar" asp-route-Id="@item.Id" class="btn btn-primary mx-1">Editar</a>
                                <a asp-controller="Cliente" asp-action="Eliminar" asp-route-Id="@item.Id" class="btn btn-danger mx-1">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay registros de clientes</p>
    }
</div>
