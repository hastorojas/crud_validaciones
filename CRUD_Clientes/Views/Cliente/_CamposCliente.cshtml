@model CRUD_Clientes.Models.Cliente

<div class="row mb-2">
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
</div>

<div class="row mb-2">
    <div class="col-md-6">
        <label asp-for="TipoDocumento" class="form-label"></label>
        <select asp-for="TipoDocumento" asp-items="ViewBag.TiposDocumento" class="form-select">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="TipoDocumento" class="text-danger"></span>
    </div>
</div>

<div class="row mb-2">
    <div class="col-md-6">
        <label asp-for="Documento" class="form-label"></label>
        <input asp-for="Documento" class="form-control" />
        <span asp-validation-for="Documento" class="text-danger"></span>
    </div>
</div>

<div class="row mb-2">
    <div class="col-md-6">
        <label asp-for="Celular" class="form-label"></label>
        <input asp-for="Celular" class="form-control" />
        <span asp-validation-for="Celular" class="text-danger"></span>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>
</div>
